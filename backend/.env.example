# LearnBridge / CapacityConnect - Backend Environment Configuration Template
# Copy this file to .env and configure values for your environment.

# JWT Secret Key for token signing and verification (Change to a cryptographically secure random string in production)
SECRET_KEY=

# Administrative Secret Key for API bypass / automated bootstrap approval
ADMIN_SECRET_KEY=

# Access Token Expiration Time in minutes (Default: 1440 minutes = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Assessment Passing Score Threshold percentage (Default: 50.0%)
DEFAULT_PASSING_SCORE=50.0
